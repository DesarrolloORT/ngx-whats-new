{
  "name": "ngx-whats-new-lib",
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "build": "npm run build:angularjs && ng build ngx-whats-new",
    "build:angularjs": "cd projects/angularjs-whats-new && npm run build",
    "build:angular": "ng build ngx-whats-new",
    "build:app": "ng build test-app",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:ci": "npm run test -- --ci --silent --maxWorkers=3 --no-watchman",
    "test:sonar": "npm run test -- --coverage --ci --no-watchman --coverageReporters=lcov --maxWorkers=3 --silent --clearMocks",
    "test:snapshot": "npm run test -- --updateSnapshot",
    "test:coverage": "npm run test -- --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run lint:check && npm run format:check && npm run test && npm run build:app && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^20.0.1",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "ngx-whats-new": "file:dist/ngx-whats-new",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular-eslint/builder": "^19.7.1",
    "@angular-eslint/eslint-plugin": "^19.7.1",
    "@angular-eslint/eslint-plugin-template": "^19.7.1",
    "@angular-eslint/schematics": "^19.7.1",
    "@angular-eslint/template-parser": "^19.7.1",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.28.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@typescript-eslint/types": "^8.33.1",
    "@typescript-eslint/utils": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "^30.4.2",
    "jest-preset-angular": "^14.6.0",
    "ng-packagr": "^21.2.6",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.4.2",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3"
  }
}
